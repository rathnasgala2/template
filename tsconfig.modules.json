{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "checkJs": true,
    "allowJs": true,
    "strict": false,
    "noEmit": true,
    "types": [],
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": ["src/modules/**/*.js"]
}
